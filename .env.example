# MultiModal RAG Configuration
# Copy this file to .env and fill in your API keys

# === LM Studio (Recommended for local development) ===
# LM Studio runs a local OpenAI-compatible API server on port 1234
LM_STUDIO_API_BASE=http://localhost:1234/v1
LM_STUDIO_API_KEY=sk-lm-studio  # LM Studio uses this dummy key

# === LM Studio model names (change to match your loaded models) ===
LM_STUDIO_MODEL=Qwen/Qwen2.5-72B-Instruct  # For RAG generation (text model)
LM_STUDIO_EMBEDDING_MODEL=bge-large-en-v1.5  # For vector embeddings
LM_STUDIO_VISION_MODEL=Qwen/Qwen2-VL-72B-Instruct  # For image transcription (vision model)

# === FreeLLMAPI (alternative local server) ===
# FREELLM_API_BASE=http://127.0.0.1:31415/v1
# FREELLM_API_KEY=freellmapi-b932a4af909ec38af42a9059580cffb14c29631ae8507d8a

# === OpenAI Cloud (alternative) ===
# Uncomment these to use OpenAI's cloud API instead
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_API_BASE=  # Optional: custom endpoint URL

# === Anthropic API (optional, for Claude models) ===
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# === Vector Database (optional, for cloud backends) ===
# PINECONE_API_KEY=  # Only needed if using Pinecone
# PINECONE_ENVIRONMENT=us-east1-aws

# QDRANT_URL=  # Only needed if using Qdrant (e.g., http://localhost:6333)
# QDRANT_API_KEY=  # Only needed if using Qdrant
